# ==============================================================================
# CorpusAI Backend — Environment Configuration Template
# Copy this file to .env and populate with your project credentials.
# NEVER commit the active .env file containing real secrets.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Supabase Project Configuration
# Available in your Supabase Dashboard: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT Verification Secret
# In Supabase: Settings -> API -> JWT Settings -> JWT Secret
# Used to verify Bearer JWT signatures issued to client sessions
JWT_SECRET=your-supabase-jwt-secret
